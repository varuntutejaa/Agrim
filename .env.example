# Copy to .env and fill in. Never commit .env.

# Optional contact added to the User-Agent sent to OSM Nominatim/Overpass
# (their usage policy asks for one). Use a team address, e.g. "(team@example.com)".
NOMINATIM_CONTACT=

# Comma-separated origins allowed to call the API (the React app).
CORS_ORIGINS=http://localhost:5173

# Milestone 7: optional SMS sandbox. Leave blank to log alerts to the console.
# Never put real phone numbers here for the demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_AUTH_KEY=

# Milestone 3: background forecast runs (twice daily, hourly in storm mode).
# Turn on for the hosted server; leave off while developing with --reload.
SCHEDULER=off
# Optional: if set, POST /forecast/run needs header  x-agrim-token: <value>
RUN_TOKEN=
