# Copy to .env and fill in. Never commit .env.

# Optional contact added to the User-Agent sent to OSM Nominatim/Overpass
# (their usage policy asks for one). Use a team address, e.g. "(team@example.com)".
NOMINATIM_CONTACT=

# Comma-separated origins allowed to call the API (the React app).
CORS_ORIGINS=http://localhost:5173

# Milestone 7: alerts. "console" (default) only writes to the server log.
# "twilio" sends SMS, but ONLY to ALERT_TEST_NUMBERS (comma-separated, your own
# verified test phones). Never put real citizens' numbers here.
ALERT_CHANNEL=console
ALERT_TEST_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Milestone 3: background forecast runs (twice daily, hourly in storm mode).
# Turn on for the hosted server; leave off while developing with --reload.
SCHEDULER=off
# Optional: if set, POST /forecast/run needs header  x-agrim-token: <value>
RUN_TOKEN=

# Milestone 5: MCG desk storage. Neon Postgres connection string, e.g.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require   (use Neon's "pooled" host)
DATABASE_URL=
# Optional: if set, officers enter this desk code once before overriding,
# ticking the checklist or sending feedback.
OPS_TOKEN=
